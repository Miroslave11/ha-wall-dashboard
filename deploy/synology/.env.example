# Zkopíruj jako .env (vedle docker-compose.yml) a vyplň. Soubor .env nikdy nesdílej – obsahuje API klíč.

# Port, na kterém dashboard poběží: http://<IP-NASu>:8099
DASHBOARD_PORT=8099

# Verze image: "latest" = automatické aktualizace na každé nové vydání.
# Konkrétní verze (např. 1.0.0) aktualizace zastaví – hodí se pro návrat ke starší verzi.
DASHBOARD_TAG=latest

# Složka s fotkami pro fotorámeček (zdroj "autoindex"). Při zdroji Immich ji nech být.
PHOTOS_DIR=/volume1/photo/Ramecek

# Immich (zdroj "immich"): adresa v LAN bez lomítka na konci. Z kontejneru nejde "localhost" – použij IP NASu.
IMMICH_URL=http://192.168.1.10:2283

# API klíč: Immich → Nastavení účtu → Klíče API → Nový klíč.
# Potřebná oprávnění: album.read, asset.read a asset.view.
IMMICH_API_KEY=
