# Zkopíruj jako .env (je v .gitignore) a vyplň. Čte ho docker compose i vývojový server (npm run dev).
# Pro NAS je samostatná šablona v deploy/synology/.env.example.

# Adresa Immiche v LAN, bez lomítka na konci. Z kontejneru nejde "localhost" – použij IP NASu a port Immiche.
IMMICH_URL=http://192.168.1.10:2283

# API klíč: Immich → Nastavení účtu → Klíče API → Nový klíč.
# Potřebná oprávnění: album.read, asset.read a asset.view (nebo vše pro jednoduchost).
IMMICH_API_KEY=
